# ==============================================================================
# AI TRADING ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN LOCAL SECRETS.
# NEVER COMMIT THE REAL .env FILE OR ANY CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE OPERATIONAL & TRADING SAFETY MODES
# ------------------------------------------------------------------------------
# DEFAULT MUST REMAIN FALSE.
# When LIVE_TRADING=false, the application is technically blocked from submitting
# real orders to any external broker or exchange. All executions route through
# the paper trading engine or backtester.
LIVE_TRADING=false

# Global Emergency Kill Switch (true = immediately block orders, cancel open orders)
EMERGENCY_KILL_SWITCH=false

# Operational Environment: development | staging | production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Application Base URLs
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & CACHING
# ------------------------------------------------------------------------------
# PostgreSQL (persistent source of truth: instruments, orders, trades, signals, audit logs)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/trading_db

# Redis (real-time market state, rate limiting, pub/sub, temporary state)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a secure 64-char string for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_super_secure_random_string_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Bootstrap Admin Credentials (used only on clean first initialization)
BOOTSTRAP_ADMIN_EMAIL=admin@tradingengine.local
BOOTSTRAP_ADMIN_PASSWORD=change_this_secure_admin_password_123!

# ------------------------------------------------------------------------------
# 4. GLOBAL RISK MANAGEMENT LIMITS (STRICTLY ENFORCED BY RISK ENGINE)
# ------------------------------------------------------------------------------
# Maximum capital risk per individual trade as a percentage of total account equity (e.g., 0.01 = 1%)
RISK_MAX_RISK_PER_TRADE_PCT=0.01

# Maximum permissible loss in a single trading day before trading is halted (e.g., 0.03 = 3%)
RISK_MAX_DAILY_LOSS_PCT=0.03

# Maximum portfolio drawdown threshold before global trading suspension (e.g., 0.10 = 10%)
RISK_MAX_PORTFOLIO_DRAWDOWN_PCT=0.10

# Maximum concurrent open positions allowed
RISK_MAX_OPEN_POSITIONS=10

# Maximum single position exposure as fraction of total portfolio (e.g., 0.15 = 15%)
RISK_MAX_SINGLE_POSITION_PCT=0.15

# Minimum risk-to-reward ratio required for discretionary/strategy signals
RISK_MIN_RISK_REWARD_RATIO=1.5

# ------------------------------------------------------------------------------
# 5. MARKET DATA & BROKER INTEGRATION CREDENTIALS (LEAVE EMPTY IF UNCONFIGURED)
# ------------------------------------------------------------------------------
# Indian Markets (NSE / BSE Equities & Derivatives - e.g. Zerodha Kite Connect, Upstox, Dhan)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Crypto Exchanges (Binance / OKX / CCXT compatible)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Forex Brokers (OANDA / Interactive Brokers)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & NOTIFICATION CHANNELS
# ------------------------------------------------------------------------------
# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email / SMTP Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO_ADDRESSES=
ALERT_ON_SIGNALS=true
ALERT_ON_EXECUTION=true
ALERT_ON_RISK_EVENTS=true
